# Raspberry Pi / home-server deployment.
# Copy to .env on the Pi and edit:  cp .env.rpi.example .env
#
# docker-compose.rpi.yml reads this file (auto-loaded by `docker compose`).
# Required vars are validated at compose-up time and fail loudly if missing.

# ─── MongoDB credentials (REQUIRED) ──────────────────────────────────────────
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me
MONGO_DB=budget

# ─── JWT signing secret (REQUIRED) ───────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-min-32-random-chars

# ─── Image source ────────────────────────────────────────────────────────────
# GHCR namespace (the GitHub user/org that owns the budget repo). Override only
# if you forked the repo into a different account.
GHCR_OWNER=msdnna

# Pinned versions. `make rpi-up` reads VERSION files from the working tree, so
# these are usually unnecessary — keep them empty unless you want to pin
# explicitly (e.g. roll back to an older release without checking it out).
# API_VERSION=1.20.0
# WEB_VERSION=1.32.0

# ─── Networking ──────────────────────────────────────────────────────────────
# Host port for the frontend nginx. Default 80 (LAN-only).
WEB_HOST_PORT=80

# Timezone (Mongo + backend + frontend).
TZ=Europe/Moscow

# ─── Android update channel (advertised by /api/version) ─────────────────────
# Usually overridden automatically by tools/bump-version.sh — leave commented
# unless you want to pin a different channel on this server.
# ANDROID_LATEST=1.37.4
# ANDROID_MIN_REQUIRED=1.12.0

# ─── Sentry (error tracking + performance) ───────────────────────────────────
# Self-hosted Sentry runs on the desktop and is reachable on the LAN at :9100.
# Leave SENTRY_DSN empty to disable telemetry on this server.
# SENTRY_DSN=http://<key>@192.168.x.x:9100/<project-id>
# SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=1.0
# Frontend (Vue) Sentry — separate project. Served to the browser via
# /api/client-config and relayed via /api/sentry-tunnel (host must be reachable
# from this backend, i.e. the desktop's LAN IP).
# SENTRY_FRONTEND_DSN=http://<key>@192.168.x.x:9100/<frontend-project-id>
# SENTRY_FRONTEND_TRACES_SAMPLE_RATE=0.1
# Telegram-bot Sentry — separate project. Mapped onto the bot container's
# SENTRY_DSN; host must be in the bot's NO_PROXY.
# SENTRY_BOT_DSN=http://<key>@192.168.x.x:9100/<bot-project-id>
# SENTRY_BOT_TRACES_SAMPLE_RATE=0.1
