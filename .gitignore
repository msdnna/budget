# ─── Secrets & local config ──────────────────────────────────────────────────
.env
*.env.local

# ─── Go ──────────────────────────────────────────────────────────────────────
backend/bin/
backend/*.exe
# Local builds of cmd/* tools (e.g. `go build ./cmd/migrate` produces ./backend/migrate)
backend/migrate
backend/seed_loadtest
backend/create_user
# Coverage profiles from `make test-backend-cover`
backend/coverage.out
backend/cover.html

# ─── Frontend ────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
# Coverage from `make test-web-cover`
frontend/coverage/

# ─── Android ─────────────────────────────────────────────────────────────────
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/local.env
android/*.apk
android/*.aab

# Self-distributed APK store (served by frontend nginx at /apks/)
apks/*.apk

# ─── Aggregated reports (make lint / make test → tools/aggregate-reports.py) ─
reports/

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs & temp ─────────────────────────────────────────────────────────────
*.log
tmp/
