# ─── Secrets & local config ──────────────────────────────────────────────────
.env
*.env.local

# ─── Go ──────────────────────────────────────────────────────────────────────
backend/bin/
backend/*.exe
# Local builds of cmd/* tools (e.g. `go build ./cmd/migrate` produces ./backend/migrate)
backend/migrate
backend/seed_loadtest
backend/create_user
# Coverage profiles from `make test-backend-cover`
backend/coverage.out
backend/cover.html

# ─── Frontend ────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
# Coverage from `make test-web-cover`
frontend/coverage/
# Yarn 4 (berry) artifacts — yarn.lock and .yarnrc.yml are tracked; local cache/installs are not
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/sdks
!frontend/.yarn/versions
frontend/.pnp.*

# ─── Telegram bot (Python) ──────────────────────────────────────────────────
telegram_bot/.venv/
telegram_bot/**/__pycache__/
telegram_bot/**/*.pyc
telegram_bot/**/*.pyo
telegram_bot/.pytest_cache/
telegram_bot/.ruff_cache/
telegram_bot/**/*.egg-info/
telegram_bot/uv.lock

# ─── Docs site build (MkDocs) ───────────────────────────────────────────────
site/
docs/api/

# ─── Local compose overrides ────────────────────────────────────────────────
# Подхватываются Makefile-таргетами автоматически если файл существует.
# Используются для машино-специфичной конфигурации, которая не должна
# конфликтовать при `git pull` (e.g. LAN-specific IPs, локальные тюны).
docker-compose.*.override.yml
docker-compose.override.yml
.env.local
.env.override

# ─── Android ─────────────────────────────────────────────────────────────────
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/local.env
android/*.apk
android/*.aab

# Self-distributed APK store (served by frontend nginx at /apks/)
apks/*.apk

# ─── Aggregated reports (make lint / make test → tools/aggregate-reports.py) ─
reports/

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs & temp ─────────────────────────────────────────────────────────────
*.log
tmp/
