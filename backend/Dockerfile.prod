FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git tzdata font-dejavu

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags='-w -s' -o main .

# gcr.io/distroless/static — no shell, no package manager, minimal attack surface.
# Timezone data and DejaVu fonts are copied from the builder stage.
FROM gcr.io/distroless/static-debian12

COPY --from=builder /app/main               /app/main
COPY --from=builder /usr/share/fonts/dejavu /usr/share/fonts/dejavu
COPY --from=builder /usr/share/zoneinfo     /usr/share/zoneinfo

EXPOSE 8080

ENTRYPOINT ["/app/main"]
