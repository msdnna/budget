FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git tzdata font-dejavu

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags='-w -s' -o main . \
 && CGO_ENABLED=0 GOOS=linux go build -a -ldflags='-w -s' -o create_user ./cmd/create_user

# gcr.io/distroless/static-debian12:nonroot — no shell, no package manager, runs
# as uid 65532. Minimal attack surface; tz data and DejaVu fonts copied from
# the builder stage.
FROM gcr.io/distroless/static-debian12:nonroot

# OCI image labels — picked up by GHCR / GitHub releases UI when published via Actions.
ARG API_VERSION=dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="msdnna-budget-backend" \
      org.opencontainers.image.description="Go REST API for msdnna-budget (MongoDB)." \
      org.opencontainers.image.source="https://github.com/msdnna/budget" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${API_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"

COPY --from=builder /app/main               /app/main
# CLI used for first-run setup on prod/RPi deploys (distroless has no shell,
# so we ship the binary directly and invoke it via `docker compose exec`).
COPY --from=builder /app/create_user        /app/create_user
COPY --from=builder /usr/share/fonts/dejavu /usr/share/fonts/dejavu
COPY --from=builder /usr/share/zoneinfo     /usr/share/zoneinfo

USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/main"]
